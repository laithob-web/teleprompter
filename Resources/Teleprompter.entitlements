<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Needed from Phase 2 onward (microphone) and Phase 3 (system audio tap).
	     Harmless in Phase 1, and declaring it up front keeps the ad-hoc signature
	     stable so macOS does not re-prompt for permission on every rebuild. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
